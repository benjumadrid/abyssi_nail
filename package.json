{
  "name": "abysii-nail-art-house",
  "version": "1.0.0",
  "description": "Backend API for Nail Art House management and online registration",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "dev": "nodemon server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "db:test": "node scripts/test-db.js",
    "db:init": "node scripts/init-db.js",
    "admin:reset": "node scripts/reset-admin.js"
  },
  "keywords": [
    "nail-art",
    "beauty-salon",
    "neon-db",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
